# ==============================================================================
# Sweeft — environment configuration
# Copy to .env and fill in real values. NEVER commit .env
# ==============================================================================

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
POSTGRES_DB=sweeft
POSTGRES_USER=sweeft
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# QoreChain — Diana testnet (EVM chain ID 9800, Cosmos chain ID qorechain-diana)
# ------------------------------------------------------------------------------
QORECHAIN_NETWORK=testnet
QORECHAIN_CHAIN_ID=qorechain-diana
QORECHAIN_EVM_CHAIN_ID=9800
QORECHAIN_REST_URL=https://api-testnet.qore.host
QORECHAIN_RPC_URL=https://rpc-testnet.qore.host
QORECHAIN_EVM_RPC_URL=https://evm-testnet.qore.host
QORECHAIN_EXPLORER_URL=https://explore.qore.network

# PQC precompiles (testnet only)
QORECHAIN_PQC_VERIFY_ADDRESS=0x0000000000000000000000000000000000000a01
QORECHAIN_PQC_KEY_STATUS_ADDRESS=0x0000000000000000000000000000000000000a02

# Deployed Sweeft contracts (fill after deploy)
SWEEFT_VAULT_ADDRESS=
SWEEFT_MARKETPLACE_ADDRESS=
SWEEFT_ORACLE_REGISTRY_ADDRESS=
SWEEFT_DAO_ADDRESS=

# Deployer / relayer keys — TESTNET THROWAWAY ACCOUNTS ONLY.
# Never put a key here that holds real funds.
DEPLOYER_PRIVATE_KEY=
RELAYER_MNEMONIC=
RELAYER_PQC_RECOVERY_CODE=

# ------------------------------------------------------------------------------
# AI — Meta Model API (https://api.meta.ai/v1)
# ------------------------------------------------------------------------------
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_MODEL_EXTRACT=muse-ember-1.0
META_MODEL_REASON=muse-spark-1.3
